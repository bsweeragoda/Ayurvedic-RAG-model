{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["disease_id", "disease", "definition", "samprapti"],
  "properties": {
    "disease_id": {"type":"string"},
    "disease": {
      "type":"object",
      "properties":{"si":{"type":"string"},"en":{"type":"string"}}
    },
    "definition": {"type":"object"},
    "samprapti": {"type":"object"},
    "symptoms": {"type":"object"},
    "treatments": {"type":"object"},
    "images": {"type":"array"}
  }
}
